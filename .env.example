# Optional local API port; default used by pnpm start.
PORT=4300
# Mount a persistent disk here before a hosted launch. Account databases use its accounts/ directory.
# LEDGERLY_DATA_DIRECTORY=/var/lib/ledgerly

# Hosted mode: HTTPS reverse proxy; the application authenticates provisioned accounts.
# APP_PUBLIC_ORIGIN=https://operator.example

# Exact source SHA set by the release process; omitted reports local-unversioned.
# APP_REVISION=

# JSON mapping usernames to SHA-256 hashes of random access secrets (>=32 characters).
# APP_ACCOUNTS={"owner":"replace-with-64-character-sha256-hex-digest"}
